<?xml version="1.0" encoding="utf-8"?>
<!-- 知川助手第 1 步：启动窗口背景是一个纯色，不是渐变。
     与 values-v31 的 windowSplashScreenBackground 用同一个颜色，
     Kotlin 也把它原样交给 Flutter 的第一帧（LaunchScreen.kt），
     所以系统页 → Flutter 之间没有颜色跳变，也没有任何图标形状。
     立绘由 Dart 层淡入并缓慢推近（lib/ui/launch/launch_overlay.dart）。 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/launch_background_top" />
        </shape>
    </item>
</layer-list>
